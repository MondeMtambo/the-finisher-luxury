# ==========================================
# THE FINISHER LUXURY - Environment Config
# Mtambo Holdings Group
# ==========================================

SECRET_KEY=tfl-production-enterprise-secret-key-change-me
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,thefinisher.tech,www.thefinisher.tech,thefinishercrm.tech,the-finisher-luxury-be.fly.dev

# Supabase PostgreSQL (URI from Supabase Settings -> Database -> Connection String -> URI)
# Example: postgresql://postgres.[project-ref]:[password]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?sslmode=require

# Two-Factor Authentication & Domain Email (thefinisher.tech)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=thefinishercrm@gmail.com
EMAIL_HOST_PASSWORD=your-app-specific-password
DEFAULT_FROM_EMAIL=security@thefinisher.tech

# Frontend URL
FRONTEND_URL=https://thefinisher.tech

# SMS Gateway (Optional: Twilio or South African SMSPortal)
SMS_API_KEY=
SMS_SENDER_ID=FINISHER
